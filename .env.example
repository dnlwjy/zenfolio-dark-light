# ─────────────────────────────────────────────────────────────
# Sanity (CMS)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# ─────────────────────────────────────────────────────────────
# ReCAPTCHA
# v2 (checkbox) dipakai form kontak — key ini sudah ada di project.
# Chatbot memakai reCAPTCHA v3 (score-based, tanpa interaksi pengunjung),
# jadi memerlukan pasangan key TERPISAH. Buat di:
#   https://www.google.com/recaptcha/admin/create
# Domains: danielwijaya.com, www.danielwijaya.com, localhost
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Google Analytics
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_measurement_id

# ─────────────────────────────────────────────────────────────
# Resend (form kontak — laporan chatbot ditunda ke tahap lanjut)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM_EMAIL=Your Name <noreply@example.com>
CONTACT_TO_EMAIL=your@email.com
CONTACT_RATE_LIMIT_WINDOW_MINUTES=3
CONTACT_RATE_LIMIT_MAX_REQUESTS=2

# ─────────────────────────────────────────────────────────────
# CHATBOT — Provider LLM (registry provider: lib/ai/providers.ts)
# ─────────────────────────────────────────────────────────────
# Provider & model aktif. Ganti keduanya untuk berpindah provider tanpa mengubah kode.
LLM_PROVIDER=opencode
LLM_MODEL=glm-5.3-flash
LLM_FALLBACK_MODEL=deepseek-v4.1-flash
LLM_MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_MS=30000

# API key per provider — isi HANYA yang dipakai (server-only, jangan pakai prefix NEXT_PUBLIC)
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────
# CHATBOT — Database (Supabase, akses langsung Postgres via Drizzle)
# Anon key / service role key TIDAK dipakai: aplikasi tidak memakai Data API (PostgREST).
# Ambil dari Dashboard → Connect:
#   DATABASE_URL        → Transaction pooler (port 6543) untuk runtime serverless
#   DATABASE_URL_MIGRATE→ Session pooler / direct (port 5432) untuk menjalankan migrasi
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL_MIGRATE=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_PROJECT_REF=

# ─────────────────────────────────────────────────────────────
# CHATBOT — Batas percakapan & rate limit
# (default kode ada di lib/config/chat.ts; isi di sini hanya bila ingin menimpa)
# ─────────────────────────────────────────────────────────────
CHAT_MAX_INPUT_CHARS=1000
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_MAX_HISTORY_MESSAGES=6
CHAT_HISTORY_MESSAGE_MAX_CHARS=400
CHAT_MAX_TURNS_PER_SESSION=8
CHAT_REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_STORE=db
CHAT_RL_MESSAGES_PER_MINUTE=6
CHAT_RL_SESSIONS_PER_IP_PER_DAY=5
CHAT_RL_MESSAGES_PER_IP_PER_DAY=25
CHAT_DAILY_TURN_CAP=80

# ─────────────────────────────────────────────────────────────
# CHATBOT — Anggaran biaya (target $3–5/bulan)
# Breaker harian × 30 ≈ batas bulanan. Semua nilai USD.
# ─────────────────────────────────────────────────────────────
CHAT_DAILY_BUDGET_USD=0.15
CHAT_MONTHLY_BUDGET_USD=5
CHAT_BUDGET_ALERT_THRESHOLD=0.8

# ─────────────────────────────────────────────────────────────
# CHATBOT — Perlindungan abuse
# ─────────────────────────────────────────────────────────────
CHAT_RECAPTCHA_ENABLED=true
CHAT_RECAPTCHA_MIN_SCORE=0.5
CHAT_RECAPTCHA_ACTION=chat

# ─────────────────────────────────────────────────────────────
# CHATBOT — Eskalasi & data
# ─────────────────────────────────────────────────────────────
# Nomor WhatsApp tujuan (format internasional, tanpa +). Kosong = tombol WhatsApp disembunyikan.
WHATSAPP_NUMBER=62812xxxxxxx
CHAT_CONTACT_PATH=/contact
# 0 = tanpa penghapusan otomatis (keputusan v1)
CHAT_RETENTION_DAYS=0

# ─────────────────────────────────────────────────────────────
# CHATBOT — Tahap lanjut (belum dipakai di v1)
# ─────────────────────────────────────────────────────────────
# CRON_SECRET=
# INSIGHT_CADENCE=weekly,monthly
